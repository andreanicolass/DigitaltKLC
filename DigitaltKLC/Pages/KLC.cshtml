@page
@model KLCModel
@{
    ViewData["Title"] = "KLC-miljön";
}

<section class="page-header">
    <h1>Kliniskt lärandecentrum – KLC</h1>
    <p>Utforska KLC-miljön digitalt. Samma upplevelse oavsett om du befinner dig i Trollhättan, Västervik eller Dalsland.</p>
</section>

<section class="info-box">
    <h3>Varför varierade dockor?</h3>
    <p>På Högskolan Västs KLC används dockor med olika etnicitet, ålder, kroppsstorlek och hudförhållanden. Det är ett medvetet val – patienter ser inte likadana ut, och det ska träningen inte heller göra.</p>
</section>

<section class="dockor-grid-section">
    <h2>Dockorna på KLC</h2>
    <div class="dockor-grid">
        <div class="docka-kort">
            <div class="docka-ikon" style="background:#FAECE7">👤</div>
            <h4>Olika etnicitet</h4>
            <p>Dockor med varierande hudfärg och ursprung.</p>
        </div>
        <div class="docka-kort">
            <div class="docka-ikon" style="background:#E1F5EE">👶</div>
            <h4>Varierande ålder</h4>
            <p>Från nyfödda till äldre vuxna.</p>
        </div>
        <div class="docka-kort">
            <div class="docka-ikon" style="background:#EEEDFE">🧍</div>
            <h4>Olika kroppsstorlek</h4>
            <p>Speglar verkliga patienters kroppsformer.</p>
        </div>
        <div class="docka-kort">
            <div class="docka-ikon" style="background:#FAEEDA">🔬</div>
            <h4>Hudvariationer</h4>
            <p>Fettknölar, hudveck och andra variationer.</p>
        </div>
    </div>
</section>

<section class="rum-section">
    <h2>Rummen på KLC</h2>
    <div class="rum-grid">
        <div class="rum-kort">
            <div class="rum-ikon" style="background:#E1F5EE">🛏️</div>
            <div>
                <h4>Patientrum</h4>
                <p>Träna på patientbemötande och grundläggande omvårdnad.</p>
            </div>
        </div>
        <div class="rum-kort">
            <div class="rum-ikon" style="background:#EEEDFE">💊</div>
            <div>
                <h4>Medicinrum</h4>
                <p>Läkemedelshantering och hygienrutiner.</p>
            </div>
        </div>
        <div class="rum-kort">
            <div class="rum-ikon" style="background:#FAECE7">🫀</div>
            <div>
                <h4>Simuleringsrum</h4>
                <p>Avancerade scenarios med teknisk utrustning.</p>
            </div>
        </div>
        <div class="rum-kort">
            <div class="rum-ikon" style="background:#FAEEDA">🖼️</div>
            <div>
                <h4>Korridor med konst</h4>
                <p>Elisabeth Ohlsons normkritiska konstverk hänger här.</p>
            </div>
        </div>
    </div>
</section>